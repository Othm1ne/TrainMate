rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid);
      // NOTE: isPremium is client-writable until real payments are added.
      // Then move it to a Cloud Function and block it here.
      allow update: if isMe(uid);
      allow delete: if isMe(uid);

      // Swipes live under the swiper. The swiped person may read the one
      // about them (that's how a match is detected).
      match /swipes/{otherUid} {
        allow read: if isMe(uid) || isMe(otherUid);
        allow write: if isMe(uid);
      }
    }

    // "Who liked you" (collection group query on swipes).
    match /{path=**}/swipes/{swipeId} {
      allow read: if signedIn() &&
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    match /chats/{chatId} {
      function member() { return signedIn() && request.auth.uid in resource.data.members; }
      function notBlocked() { return get(/databases/$(database)/documents/chats/$(chatId)).data.blockedBy.size() == 0; }

      allow read: if member();
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if member();

      match /messages/{messageId} {
        function chatMember() {
          return signedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read: if chatMember();
        allow create: if chatMember() && notBlocked() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000;
      }
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      // Creator edits anything; others may only change attendance.
      allow update: if signedIn() && (
        resource.data.creatorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['attendeeIds', 'attendeePhotos'])
      );
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
    }
  }
}
