rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // list field `f` differs from before only by adding/removing the caller.
    function onlySelfToggled(f) {
      return request.resource.data.get(f, []).removeAll([request.auth.uid])
          == resource.data.get(f, []).removeAll([request.auth.uid]);
    }

    match /users/{uid} {
      // Server-managed: premium (activatePremium), like counters (swipe),
      // store trust fields (verification, ratings, shops, boosts).
      // Badges are granted by admins only.
      function serverFields() {
        return ['isPremium', 'likesDate', 'likesCount', 'badges', 'createdAt',
                'verified', 'phoneVerified', 'rating', 'ratingSum', 'reviewCount',
                'storeSuspended', 'freeBoostsUsed', 'boostMonth', 'shopId', 'shopStatus',
                'lateCancels'];
      }

      allow read: if signedIn();
      allow create: if isMe(uid)
        && request.resource.data.get('isPremium', false) == false
        && request.resource.data.get('badges', []).size() == 0
        && !request.resource.data.keys().hasAny(serverFields().removeAll(['isPremium', 'badges', 'createdAt']));
      allow update: if isMe(uid) && !changed().hasAny(serverFields());
      allow delete: if isMe(uid);

      // Swipes are written by the `swipe` Cloud Function only. The swiped
      // person may read the one about them.
      match /swipes/{otherUid} {
        allow read: if isMe(uid) || isMe(otherUid);
        allow write: if false;
      }

      // FCM tokens for push notifications.
      match /devices/{token} {
        allow read, write: if isMe(uid);
      }
    }

    // "Who liked you" (collection group query on swipes).
    match /{path=**}/swipes/{swipeId} {
      allow read: if signedIn() &&
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    match /chats/{chatId} {
      function member() { return signedIn() && request.auth.uid in resource.data.members; }

      allow read: if member();
      // Chats are created by Cloud Functions: `swipe` (mutual like) and
      // `contactOwner` / `requestRental` (store chats, kind == 'store').
      allow create, delete: if false;
      // Members may update the preview, their own mute/block entry and their
      // own name/photo copy — never the member list or the other person's flags.
      allow update: if member()
        && changed().hasOnly(['lastMessage', 'lastTime', 'mutedBy', 'blockedBy', 'memberInfo'])
        && onlySelfToggled('mutedBy')
        && onlySelfToggled('blockedBy')
        && request.resource.data.memberInfo.diff(resource.data.memberInfo)
             .affectedKeys().hasOnly([request.auth.uid]);

      match /messages/{messageId} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        allow read: if signedIn() && request.auth.uid in chat().members;
        allow create: if signedIn() && request.auth.uid in chat().members
          && chat().blockedBy.size() == 0
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'sentAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
      }
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      // Creator edits anything; others may only add/remove themselves.
      allow update: if signedIn() && (
        resource.data.creatorId == request.auth.uid || (
          changed().hasOnly(['attendeeIds', 'attendeePhotos'])
          && onlySelfToggled('attendeeIds')
          && request.resource.data.attendeePhotos.diff(resource.data.attendeePhotos)
               .affectedKeys().hasOnly([request.auth.uid])
        )
      );
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;
    }

    // ---- Store (docs/specs/store-sell-and-rent.md) ----
    // Every store write goes through Cloud Functions; clients only read.

    match /listings/{listingId} {
      allow read: if signedIn() && (
        resource.data.status in ['active', 'reserved', 'sold'] ||
        resource.data.ownerId == request.auth.uid);
      allow write: if false;

      // Booked days (doc id = yyyy-mm-dd) for the availability calendar.
      match /blocked/{day} {
        allow read: if signedIn();
        allow write: if false;
      }
      match /views/{uid} {
        allow read, write: if false;
      }
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow write: if false;
    }

    match /sales/{saleId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn() &&
        (resource.data.visible == true || resource.data.authorUid == request.auth.uid);
      allow write: if false;
    }

    // Admins approve shops by editing `status` in the Firebase console.
    match /shops/{shopId} {
      allow read: if signedIn() &&
        (resource.data.status == 'approved' || resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
    }
  }
}
